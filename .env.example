# Discord bot credentials (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here

# Supabase direct connection (service role key bypasses RLS - keep secret!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Role names as they appear in Discord (must match template exactly)
ROLE_FOUNDER=ELEVATES • Founder
ROLE_ADMIN=ELEVATES • Admin
ROLE_CAMPUS_LEAD=Campus Lead
ROLE_CLASS_REP=Class Rep
ROLE_VERIFIED=ELEVATES • Member
ROLE_UNVERIFIED=elevates
ROLE_GUEST=Guest

# Max failed verification attempts before pinging a Campus Lead
MAX_VERIFY_ATTEMPTS=3

# Staff DM Forwarding Channel in Main Server (default: bot-commands)
STAFF_DM_FORWARD_CHANNEL=bot-commands

# Feature Flags (default: true)
FEATURE_WELCOME_CARD=true
FEATURE_DM_FORWARDING=true
FEATURE_UNVERIFIED_NUDGE=true
FEATURE_ADMIN_BROADCAST=true
